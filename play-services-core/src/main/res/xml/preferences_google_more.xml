<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory
        android:title="@string/pref_more_settings">
    <SwitchPreferenceCompat
             android:defaultValue="true"
             android:key="auth_manager_trust_google"
             android:summary="@string/pref_auth_trust_google_summary"
             android:title="@string/pref_auth_trust_google_title"/>
    <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="auth_manager_visible"
            android:summary="@string/pref_auth_visible_summary"
            android:title="@string/pref_auth_visible_title"/>
    <SwitchPreferenceCompat
        android:defaultValue="true"
        android:enabled="true"
        android:key="network_google_enabled"
        android:summary="@string/network_google_enabled_string"
        android:title="@string/network_google_enabled_summary"/>
    <Preference
        android:icon="@drawable/ic_info_outline"
        android:selectable="true"
        android:title="@string/back_to_vancedx_title"
        android:summary="@string/back_to_vancedx_summary">
    <intent
        android:targetClass="com.google.android.youtube.HomeActivity"
        android:targetPackage="com.vancedx.android.youtube" />
    </Preference>
    <Preference
        android:selectable="false"
        android:icon="@drawable/ic_info_outline"
        android:title="@string/package_information"
        android:summary="Package name : com.mgoogle.android.gms \n Version code : 234914073
        \n minSdk : 23 \n targetSdk : 30
        \n GMS version : 23.50.14
        \n build type : " />
        <Preference
            android:selectable="true"
            android:icon="@drawable/ic_info_outline"
            android:title="@string/build_date"
            android:summary="DD MM YYYY  - nightly">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://gitlab.com/cuynu/VancedxMicroG/-/commits/master/?ref_type=HEADS" />
        </Preference>

        <Preference
            android:icon="@drawable/ic_info_outline"
            android:selectable="true"
            android:enabled="true"
            android:title="Facts"
            android:summary="Does Cuynu knows how to code? no they always stupid and dont even know what java is !">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://t.me/revanced_extended_chat/252142" />
        </Preference>
    </PreferenceCategory>
</PreferenceScreen>
