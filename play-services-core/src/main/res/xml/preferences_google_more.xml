<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory
        android:title="@string/account_manager_title">
        <Preference
            android:title="@string/manage_googleaccount_title"
            android:summary="@string/manage_googleaccount_summary"
            android:icon="@drawable/ic_info_outline"
            android:selectable="true">
            <intent
                android:targetClass="com.android.settings.Settings$AccountDashboardActivity"
                android:targetPackage="com.android.settings" />
        </Preference>

        <Preference
            android:icon="@drawable/ic_add_account"
            android:summary="@string/pref_add_account_summary"
            android:title="@string/pref_add_account_title">
            <intent
                android:targetClass="org.microg.gms.auth.login.LoginActivity"
                android:targetPackage="com.mgoogle.android.gms" />
        </Preference>
        <Preference
            android:title="@string/manage_google_account"
            android:summary="@string/manage_google_account_summary">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://myaccount.google.com"/>
        </Preference>
        <Preference
            android:title="@string/manage_yt_activities"
            android:summary="@string/manage_yt_activities_summary">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://myactivity.google.com/product/youtube"/>
        </Preference>
        <Preference
            android:title="@string/your_data_in_youtube"
            android:summary="@string/your_data_in_youtube_summary">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://myaccount.google.com/u/0/yourdata/youtube"/>
        </Preference>
    </PreferenceCategory>
        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="auth_manager_trust_google"
            android:summary="@string/pref_auth_trust_google_summary"
            android:title="@string/pref_auth_trust_google_title"/>
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="auth_manager_visible"
            android:summary="@string/pref_auth_visible_summary"
            android:title="@string/pref_auth_visible_title"/>
        <SwitchPreference
            android:defaultValue="true"
            android:key="auth_include_android_id"
            android:summary="@string/pref_auth_include_android_id_summary"
            android:title="@string/pref_auth_include_android_id_title"/>
    <Preference
        android:icon="@drawable/ic_info_outline"
        android:selectable="false"
        android:title="@string/back_to_vancedx_title"
        android:summary="@string/back_to_vancedx_summary">
    <intent
        android:targetClass="com.google.android.youtube.HomeActivity"
        android:targetPackage="com.vancedx.android.youtube" />
    </Preference>
        <Preference
            android:selectable="true"
            android:icon="@drawable/ic_info_outline"
            android:title="@string/build_date"
            android:summary="DD MM YYYY  - nightly">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://gitlab.com/cuynu/VancedxMicroG/-/commits/master/?ref_type=HEADS" />
        </Preference>
</PreferenceScreen>
